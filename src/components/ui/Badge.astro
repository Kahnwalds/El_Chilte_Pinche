---
type Tone = "primary" | "secondary" | "tertiary" | "neutral";

interface Props {
  /** Texto de la etiqueta. También se puede usar el slot por defecto. */
  text?: string;
  tone?: Tone;
  class?: string;
}

const { text, tone = "secondary", class: className } = Astro.props;

const tones: Record<Tone, string> = {
  primary: "bg-primary-fixed text-primary",
  secondary: "bg-surface-variant text-secondary",
  tertiary: "bg-tertiary-fixed text-tertiary",
  neutral: "bg-surface-container text-on-surface-variant",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1 rounded-full px-2 py-0.5 font-label-sm text-label-sm",
    tones[tone],
    className,
  ]}
>
  <slot name="icon" />
  {text}<slot />
</span>
