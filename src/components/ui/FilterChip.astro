---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"button">, "class" | "type"> {
  /** Texto del chip. También se puede usar el slot por defecto. */
  text?: string;
  /** Estado activo. El estilo sale de aria-pressed / aria-current, no de clases duplicadas. */
  active?: boolean;
  /** Valor estable que leerá la lógica de filtros (se expone como data-filter). */
  value?: string;
  /** Si recibe href se renderiza como enlace; si no, como botón. */
  href?: string;
  class?: string;
}

const { text, active = false, value, href, class: className, ...rest } =
  Astro.props;

const Tag = href ? "a" : "button";
const state = href
  ? { href, "aria-current": active ? ("true" as const) : undefined }
  : {
      type: "button" as const,
      "aria-pressed": active ? ("true" as const) : ("false" as const),
    };
---

<Tag
  class:list={[
    "inline-flex items-center gap-1 whitespace-nowrap rounded-full px-4 py-2 font-label-sm text-label-sm font-semibold transition-all",
    "bg-surface-container-high text-on-surface hover:bg-surface-variant",
    "aria-pressed:bg-primary aria-pressed:font-bold aria-pressed:text-on-primary aria-pressed:shadow-sm aria-pressed:hover:bg-primary",
    "aria-[current=true]:bg-primary aria-[current=true]:font-bold aria-[current=true]:text-on-primary aria-[current=true]:shadow-sm aria-[current=true]:hover:bg-primary",
    "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container",
    className,
  ]}
  data-filter={value}
  {...state}
  {...rest}
>
  <slot name="icon" />
  {text}<slot />
</Tag>
