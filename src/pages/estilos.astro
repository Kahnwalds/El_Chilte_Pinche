---
import "../styles/global.css";
---

<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Prueba de tokens visuales</title>
  </head>
  <body class="p-margin">
    <h1 class="font-display text-display text-primary">El ChiltePinche</h1>
    <h2 class="font-headline-md text-headline-md text-on-surface">Titular headline-md</h2>
    <p class="font-body-md text-body-md text-on-surface-variant">Texto de cuerpo en Plus Jakarta Sans.</p>
    <div class="mt-space-lg flex gap-gutter">
      <span class="rounded-full bg-primary px-space-md py-space-sm text-on-primary font-label-lg text-label-lg">primary</span>
      <span class="rounded-lg bg-primary-container px-space-md py-space-sm text-on-primary shadow-button">primary-container</span>
      <span class="rounded-xl bg-secondary px-space-md py-space-sm text-on-secondary">secondary</span>
      <span class="rounded-sm bg-surface-container px-space-md py-space-sm text-on-surface shadow-header">surface-container</span>
    </div>
    <button class="mt-space-xl rounded-lg bg-primary-container px-space-md py-space-sm text-on-primary hover:bg-primary focus-visible:outline-2 disabled:opacity-50">Botón</button>
  </body>
</html>
